<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Negative Test Suite" parallel="methods" thread-count="8" verbose="1">

    <listeners>
        <listener class-name="com.api.automation.listeners.TestListener"/>
    </listeners>

    <test name="Negative Tests">
        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="com.api.automation.tests.negative.UserApiNegativeTests"/>
        </classes>
    </test>

</suite>
